{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/satellite.js": { "maxDuration": 55, "memory": 512 },
    "api/alerts.js":    { "maxDuration": 30, "memory": 256 },
    "api/rss.js":       { "maxDuration": 25, "memory": 256 },
    "api/intel.js":     { "maxDuration": 55, "memory": 512 },
    "api/gdelt.js":     { "maxDuration": 55, "memory": 512 },
    "api/kalshi.js":    { "maxDuration": 25, "memory": 256 },
    "api/polymarket.js":{ "maxDuration": 25, "memory": 256 }
  },
  "headers": [
    { "source": "/api/satellite(.*)", "headers": [{ "key": "Cache-Control", "value": "public, s-maxage=120, stale-while-revalidate=300" }] },
    { "source": "/api/alerts(.*)",    "headers": [{ "key": "Cache-Control", "value": "public, s-maxage=60,  stale-while-revalidate=180" }] },
    { "source": "/api/rss(.*)",       "headers": [{ "key": "Cache-Control", "value": "public, s-maxage=300, stale-while-revalidate=600" }] },
    { "source": "/api/gdelt(.*)",     "headers": [{ "key": "Cache-Control", "value": "public, s-maxage=180, stale-while-revalidate=600" }] }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/:path*" },
    { "source": "/(.*)",       "destination": "/index.html" }
  ]
}
