{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "dist/api/**/*.js": {
      "runtime": "nodejs22.x"
    }
  },
  "headers": [
    { "source": "/api/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, s-maxage=120, stale-while-revalidate=300" }] },
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ],
  "rewrites": [
    { "source": "/api/satellite", "destination": "/dist/api/satellite.js" },
    { "source": "/api/firms", "destination": "/dist/api/firms.js" },
    { "source": "/api/ingest", "destination": "/dist/api/ingest.js" },
    { "source": "/api/alerts", "destination": "/dist/api/alerts.js" },
    { "source": "/api/gdelt", "destination": "/dist/api/gdelt.js" },
    { "source": "/api/intel", "destination": "/dist/api/intel.js" },
    { "source": "/api/kalshi", "destination": "/dist/api/kalshi.js" },
    { "source": "/api/polymarket", "destination": "/dist/api/polymarket.js" },
    { "source": "/api/rss", "destination": "/dist/api/rss.js" },
    { "source": "/api/fred", "destination": "/dist/api/fred.js" },
    { "source": "/api/signals", "destination": "/dist/api/signals.js" },
    { "source": "/api/threats", "destination": "/dist/api/threats.js" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
