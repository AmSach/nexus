# ══════════════════════════════════════════════════════════════════
# NEXUS — Environment Variables
# Copy to .env.local and fill in your values. NEVER commit .env.local
# ══════════════════════════════════════════════════════════════════

# ── Supabase (required for backend mode) ─────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# ── Optional: BYOK keys for enhanced features ─────────────────────
# All keys are stored in browser localStorage, never sent to your server.
# Users can also set these in Settings → API Keys within the app.
VITE_GROQ_KEY=           # console.groq.com — free tier — AI briefings
VITE_FIRMS_KEY=          # firms.modaps.eosdis.nasa.gov — free — fire data
VITE_FRED_KEY=           # fred.stlouisfed.org — free — macro data
VITE_ALPHAVANTAGE_KEY=   # alphavantage.co — free tier — market data
VITE_NEWSAPI_KEY=        # newsapi.org — free tier — news
VITE_NEWSDATA_KEY=       # newsdata.io — free tier — news

# ── Server-side only (Vercel env vars, NOT VITE_ prefixed) ────────
# Set these in Vercel dashboard → Project → Settings → Environment Variables
# FIRMS_KEY=             # Same as above but server-side
# AISSTREAM_KEY=         # aisstream.io — ship tracking
# OTX_KEY=              # otx.alienvault.com — threat intel
# CF_TOKEN=             # Cloudflare — weather alerts (optional)
# CH_KEY=               # criminalip.io — threat intel (optional)
# FEC_KEY=              # fec.gov — campaign finance (optional)
# INTELX_KEY=           # intelx.io — OSINT search (optional)
# VIRUSTOTAL_KEY=       # virustotal.com — malware (optional)
# SHODAN_KEY=           # shodan.io — internet exposure (optional)
# NEWSDATA_KEY=         # newsdata.io — server-side news (optional)
